<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zw_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/zero_widget_bg"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/zw_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textSize="11sp" android:textColor="#8AB4FF" android:layout_marginEnd="6dp" android:layout_marginTop="2dp" />
        <TextView android:id="@+id/zw_title" android:text="Отпуск" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/zero_w_tx"
            android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>

    <TextView android:id="@+id/zw_days" android:text="12" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="52sp" android:textStyle="bold" android:textColor="@color/zero_w_tx"
        android:fontFeatureSettings="tnum" android:includeFontPadding="false" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/zw_word" android:text="дней" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/zero_w_mu2" />
        <TextView android:id="@+id/zw_hm" android:text="08:30" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/zero_w_mu2" android:fontFeatureSettings="tnum" android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView android:id="@+id/zw_sub" android:text="15 декабря, 08:30" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/zero_w_mu" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
